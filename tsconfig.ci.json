{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "context/**/*.ts",
    "context/**/*.tsx",
    "data/**/*.ts",
    "i18n/**/*.ts",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "middleware.ts",
    "types/**/*.ts",
    "types/**/*.d.ts",
    "vitest.config.ts",
    "**/*.{test,spec}.ts",
    "**/*.{test,spec}.tsx"
  ],
  "exclude": ["node_modules", ".next"]
}
